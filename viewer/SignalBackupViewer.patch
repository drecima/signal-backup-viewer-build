@@ -6,6 +6,78 @@
 #import "OWSAsserts.h"
 #import <SignalServiceKit/SignalServiceKit-Swift.h>
 
+#if SIGNAL_BACKUP_VIEWER
+#import <Network/Network.h>
+#import <errno.h>
+#import <netdb.h>
+#import <sys/socket.h>
+
+#define SBV_INTERPOSE(_replacement, _replacee) \
+    __attribute__((used)) static struct { \
+        const void *replacement; \
+        const void *replacee; \
+    } _sbv_interpose_##_replacee __attribute__((section("__DATA,__interpose"))) = { \
+        (const void *)(unsigned long)&_replacement, \
+        (const void *)(unsigned long)&_replacee \
+    }
+
+static int sbv_connect(int socket, const struct sockaddr *address, socklen_t addressLength)
+{
+    (void)socket;
+    (void)address;
+    (void)addressLength;
+    errno = ENETDOWN;
+    return -1;
+}
+
+static int sbv_connectx(
+    int socket,
+    const sa_endpoints_t *endpoints,
+    sae_associd_t associationId,
+    unsigned int flags,
+    const struct iovec *iov,
+    unsigned int iovCount,
+    size_t *bytesWritten,
+    sae_connid_t *connectionId)
+{
+    (void)socket;
+    (void)endpoints;
+    (void)associationId;
+    (void)flags;
+    (void)iov;
+    (void)iovCount;
+    (void)bytesWritten;
+    (void)connectionId;
+    errno = ENETDOWN;
+    return -1;
+}
+
+static int sbv_getaddrinfo(
+    const char *hostname,
+    const char *service,
+    const struct addrinfo *hints,
+    struct addrinfo **result)
+{
+    (void)hostname;
+    (void)service;
+    (void)hints;
+    if (result != NULL) {
+        *result = NULL;
+    }
+    return EAI_FAIL;
+}
+
+static void sbv_nw_connection_start(nw_connection_t connection)
+{
+    nw_connection_cancel(connection);
+}
+
+SBV_INTERPOSE(sbv_connect, connect);
+SBV_INTERPOSE(sbv_connectx, connectx);
+SBV_INTERPOSE(sbv_getaddrinfo, getaddrinfo);
+SBV_INTERPOSE(sbv_nw_connection_start, nw_connection_start);
+#endif
+
