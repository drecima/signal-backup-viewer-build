+            case .success(_, let moreBytesAvailable):
+                hasMoreFrames = moreBytesAvailable
+            case .emptyFinalFrame, .invalidByteLengthDelimiter:
+                throw OWSAssertionError("Invalid viewer identity preflight header")
+            case .protoDeserializationError(let error):
+                throw error
+            }
+
+            var contactAcis = Set<Aci>()
+            var groupMemberSets = [Set<Aci>]()
+
+            while hasMoreFrames {
+                let frame: BackupProto_Frame
+                switch stream.readFrame() {
+                case .success(let decodedFrame, let moreBytesAvailable):
+                    frame = decodedFrame
+                    hasMoreFrames = moreBytesAvailable
+                case .emptyFinalFrame:
+                    hasMoreFrames = false
+                    continue
+                case .invalidByteLengthDelimiter:
+                    throw OWSAssertionError("Invalid viewer identity preflight frame length")
+                case .protoDeserializationError(let error):
+                    throw error
+                }
+
+                guard case .recipient(let recipient)? = frame.item else { continue }
+                switch recipient.destination {
+                case .contact(let contact) where contact.hasAci:
+                    if let aci = try? Aci.parseFrom(serviceIdBinary: contact.aci) {
+                        contactAcis.insert(aci)
+                    }
+                case .group(let group) where group.hasSnapshot:
+                    let memberAcis = Set(group.snapshot.members.compactMap {
+                        try? Aci.parseFrom(serviceIdBinary: $0.userID)
+                    })
+                    if !memberAcis.isEmpty {
+                        groupMemberSets.append(memberAcis)
+                    }
+                default:
+                    continue
+                }
+            }
+
+            let nonContactMembers = groupMemberSets.map { $0.subtracting(contactAcis) }
+            guard var candidates = nonContactMembers.first else {
+                logger.warn("[Viewer] No group membership evidence for the original local ACI")
+                return nil
+            }
+            for groupCandidates in nonContactMembers.dropFirst() {
+                candidates.formIntersection(groupCandidates)
+            }
+            guard candidates.count == 1, let localAci = candidates.first else {
+                logger.warn("[Viewer] Original local ACI inference was ambiguous; candidates=\(candidates.count)")
+                throw OWSAssertionError("Unable to identify the original local account unambiguously")
+            }
+
+            logger.info("[Viewer] Recovered original local ACI from backup relationships")
+            return localAci
+        }
+    }
+#endif
