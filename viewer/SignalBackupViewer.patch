+#if SIGNAL_BACKUP_VIEWER
+    /// Local backups carry their backup ID encrypted in the adjacent metadata file.
+    /// The viewer uses that value so importing does not depend on a registered ACI.
+    public init(
+        accountEntropyPool: AccountEntropyPool,
+        localBackupMetadataData: Data,
+        viewerAci: Aci,
+    ) throws {
+        let metadata = try LocalBackupProto_Metadata(serializedBytes: localBackupMetadataData)
+        guard
+            metadata.version == 1,
+            metadata.hasBackupID,
+            metadata.backupID.iv.count == 12,
+            metadata.backupID.encryptedID.count == 16
+        else {
+            throw OWSAssertionError("Invalid local backup metadata")
+        }
+
+        let backupKey = accountEntropyPool.getBackupKey()
+        let metadataKey = backupKey.deriveLocalBackupMetadataKey()
+        let nonce = metadata.backupID.iv + Data(count: 4)
+        var backupId = metadata.backupID.encryptedID
+        try Aes256Ctr32.process(&backupId, key: metadataKey, nonce: nonce)
+
+        self.backupKey = backupKey
+        self.backupId = backupId
+        self.aci = viewerAci
+        self.loggingKey = accountEntropyPool.getLoggingKey()
+    }
+#endif
+
